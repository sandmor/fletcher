# Object storage (S3-compatible)
S3_REGION=auto
S3_BUCKET_NAME=my-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional — only needed for MinIO / R2 / non-AWS providers
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_URL_BASE=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true

# Modal endpoint for background processing jobs
MODAL_ENDPOINT_URL=

# Shared secret for Modal -> Convex webhook callbacks
MODAL_CALLBACK_SECRET=

# Convex Deployment Config (Auto-generated by running `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=